# Copiar los valores reales como variables de entorno de PowerShell; no guardarlos en Git.
$env:DB_URL = "jdbc:postgresql://localhost:5432/ultimashop_dev"
$env:DB_USER = "ultimashop_app"
$env:DB_PASSWORD = "REEMPLAZAR_CON_VALOR_LOCAL"

# Usuario inicial: solo se crea si no existe; no restablece contraseñas posteriores.
$env:APP_ADMIN_USERNAME = "admin"
$env:APP_ADMIN_PASSWORD = "REEMPLAZAR_CON_VALOR_LOCAL"
$env:APP_ADMIN_NAME = "Admin Demo"

# HTTP local: false. En HTTPS/despliegue: true.
$env:COOKIE_SECURE = "false"

# Correo transaccional con Brevo. Sin BREVO_API_KEY o con MAIL_ENABLED=false no se envían correos reales.
$env:MAIL_ENABLED = "false"
$env:BREVO_API_URL = "https://api.brevo.com/v3/smtp/email"
$env:BREVO_API_KEY = ""
$env:MAIL_FROM_EMAIL = ""
$env:MAIL_FROM_NAME = "Ultima Shop"
$env:APP_BASE_URL = "http://localhost:8080"
$env:MAIL_CONNECT_TIMEOUT_MS = "3000"
$env:MAIL_READ_TIMEOUT_MS = "5000"

# Vigencia de tokens (valores por defecto).
$env:INVITACION_TOKEN_HORAS = "24"
$env:RECUPERACION_TOKEN_MINUTOS = "30"

# Límites por ventana (valores por defecto). No se reinician al usar X-Forwarded-For salvo que se habilite abajo.
$env:LOGIN_MAX_CUENTA = "5"
$env:LOGIN_MAX_IP = "15"
$env:LOGIN_VENTANA_MINUTOS = "15"
$env:RECUPERACION_MAX_CUENTA = "3"
$env:RECUPERACION_MAX_IP = "10"
$env:RECUPERACION_VENTANA_MINUTOS = "30"
$env:INVITACION_MAX_CUENTA = "5"
$env:INVITACION_MAX_IP = "20"
$env:INVITACION_VENTANA_MINUTOS = "60"
$env:TRUST_PROXY_HEADERS = "false"
