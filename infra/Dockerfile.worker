FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /build
COPY api/.mvn/ .mvn/
COPY api/mvnw worker/pom.xml ./
RUN sed -i 's/\r$//' mvnw && sh ./mvnw -B -ntp dependency:go-offline
COPY worker/src/ src/
RUN sh ./mvnw -B -ntp -DskipTests package && cp target/ultima-shop-worker-0.0.1-SNAPSHOT.jar /build/app.jar
FROM eclipse-temurin:21-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=10001:10001 /build/app.jar /app/app.jar
USER 10001:10001
ENV SERVER_PORT=8082
EXPOSE 8082
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 CMD curl -fsS "http://127.0.0.1:${SERVER_PORT}/actuator/health" > /dev/null || exit 1
ENTRYPOINT ["java","-jar","/app/app.jar"]
